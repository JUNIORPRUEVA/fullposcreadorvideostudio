{
  "name": "fullpos-ad-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-brand video studio for software ads, tutorials, courses, support, and brand content.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @fullpos-ad-studio/api & npm run dev --workspace @fullpos-ad-studio/web",
    "build": "npm run build --workspace @fullpos-ad-studio/shared && npm run build --workspace @fullpos-ad-studio/video && npm run build --workspace @fullpos-ad-studio/api && npm run build --workspace @fullpos-ad-studio/web",
    "build:web": "npm run build --workspace @fullpos-ad-studio/web",
    "build:api": "npm run build --workspace @fullpos-ad-studio/api",
    "build:video": "npm run build --workspace @fullpos-ad-studio/video",
    "typecheck": "npm run typecheck --workspace @fullpos-ad-studio/shared && npm run typecheck --workspace @fullpos-ad-studio/video && npm run typecheck --workspace @fullpos-ad-studio/api && npm run typecheck --workspace @fullpos-ad-studio/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build --workspace @fullpos-ad-studio/shared && npm run build --workspace @fullpos-ad-studio/video && npm run build --workspace @fullpos-ad-studio/api && npm run test --workspaces --if-present",
    "prisma:validate": "npm run prisma:validate --workspace @fullpos-ad-studio/api",
    "prisma:generate": "npm run prisma:generate --workspace @fullpos-ad-studio/api",
    "db:init": "node scripts/init-sqlite.mjs",
    "db:push": "node scripts/prisma-db-push.mjs",
    "render:demo": "npm run render:demo --workspace @fullpos-ad-studio/video",
    "validate:video": "node scripts/validate-video.mjs",
    "assets:e2e": "node scripts/create-e2e-assets.mjs",
    "e2e:local": "node scripts/local-e2e.mjs",
    "render:phase2": "node scripts/render-phase2-test.mjs",
    "render:phase3-audio": "node scripts/render-phase3-audio-test.mjs",
    "render:phase3c-audio": "node scripts/render-phase3c-dominican-audio.mjs",
    "render:phase4-premium": "node scripts/render-phase4-premium.mjs",
    "servers:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-servers.ps1",
    "servers:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-servers.ps1",
    "dev:studio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-studio.ps1",
    "dev:studio:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/stop-studio.ps1",
    "dev:studio:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/health-check.ps1",
    "voice:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice/voice-setup.ps1",
    "voice:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice/voice-dev.ps1",
    "voice:studio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice/start-voice-studio.ps1",
    "voice:studio:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice/stop-voice-studio.ps1",
    "voice:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice/voice-test.ps1",
    "voice:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice/voice-smoke.ps1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
